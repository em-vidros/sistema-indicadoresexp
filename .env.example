# Copie para .env e ajuste. O .env nao vai para o repositorio.
# Local, uma string responde por tudo. Na Neon sao duas, e elas diferem so pelo
# `-pooler` no host: a pooled e a do runtime, a direta e a das migracoes. Trocar uma
# pela outra nao da erro na hora, so sob concorrencia, entao `criarDb` decide o
# `prepare` lendo a URL e `urlMigracao()` recusa a pooled.
DATABASE_URL=postgres://indicadores:indicadores_dev@127.0.0.1:5433/indicadores
# Vazia fora da Neon. La, a string sem `-pooler`, com sslmode=verify-full e
# channel_binding=require. O nome e o que `neon link` escreve sozinho no .env.
DATABASE_URL_UNPOOLED=
POSTGRES_USER=indicadores
POSTGRES_PASSWORD=indicadores_dev
POSTGRES_DB=indicadores
PGPORT_HOST=5433

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-isto
BETTER_AUTH_URL=http://localhost:3200

# 3000, 3001 e 3100 ja estao ocupadas nesta maquina (chatwoot, uptime-kuma,
# agente-projetista). 3200 esta livre.
PORTA_SERVIDOR=3200
# Onde os PDFs ficam. Fora do repositorio e fora do bundle publico.
ARQUIVOS_DIR=./var/arquivos
# A pasta que a rota /docs/ serve, atras da sessao. Ausente ou vazia, vale a
# `docs/` da raiz do repositorio.
# DOCS_DIR=/srv/indicadores/docs

# Uma senha por usuario. As quatro antigas estao em base64 dentro de
# formulario-registro.html, com um atob() ao lado: ja vazaram e nao voltam.
# O seed le estas, e `verificar/fase-0.sh` usa SENHA_LIVIA para provar o login.
SENHA_LIVIA=troque-isto-livia
SENHA_ANDREINA=troque-isto-andreina
SENHA_LUCASCUNHA=troque-isto-lucascunha
SENHA_BELEM=troque-isto-belem

# So em producao. A Vercel injeta VERCEL=1 sozinha, e e ela que troca o
# armazenamento de arquivo do disco para o Blob; BLOB_READ_WRITE_TOKEN vem junto
# quando o Blob esta ligado no projeto. Nada disso se define aqui.
