# Copie para .env e ajuste. O .env nao vai para o repositorio.
DATABASE_URL=postgres://indicadores:indicadores_dev@127.0.0.1:5433/indicadores
POSTGRES_USER=indicadores
POSTGRES_PASSWORD=indicadores_dev
POSTGRES_DB=indicadores
PGPORT_HOST=5433

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-isto
BETTER_AUTH_URL=http://localhost:3200

# 3000, 3001 e 3100 ja estao ocupadas nesta maquina (chatwoot, uptime-kuma,
# agente-projetista). 3200 esta livre.
PORTA_SERVIDOR=3200
# Onde os PDFs ficam. Fora do repositorio e fora do bundle publico.
ARQUIVOS_DIR=./var/arquivos

# Uma senha por usuario. As quatro antigas estao em base64 dentro de
# formulario-registro.html, com um atob() ao lado: ja vazaram e nao voltam.
# O seed le estas, e `verificar/fase-0.sh` usa SENHA_LIVIA para provar o login.
SENHA_LIVIA=troque-isto-livia
SENHA_ANDREINA=troque-isto-andreina
SENHA_LUCASCUNHA=troque-isto-lucascunha
SENHA_BELEM=troque-isto-belem
