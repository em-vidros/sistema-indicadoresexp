{
  "name": "indicadores",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "banco": "./infra/banco.sh",
    "db:generate": "bun --filter @ind/db db:generate",
    "db:migrate": "bun --filter @ind/db db:migrate",
    "db:seed": "bun --filter @ind/db seed",
    "dev": "bun --watch server.ts",
    "build": "bun --filter @ind/web build",
    "tipos": "tsc -b",
    "teste": "bun test",
    "fronteiras": "bun verificar/fronteiras.ts",
    "paridade": "bun verificar/paridade.ts",
    "telas": "bun verificar/handlers.ts && bun run build && bun verificar/visual-telas.ts && bun verificar/publicos.ts && bun verificar/paridade.ts",
    "verificar": "bun run fronteiras && bun run telas && bun run tipos && bun run teste",
    "start": "bun server.ts"
  },
  "devDependencies": {
    "@neon/config": "^1.2.0",
    "@types/bun": "^1.2.20",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  }
}
