                  "descricao": "Leitura e interpretação dos roteiros de rota diários, análise de itinerários, rotas permitidas para veículos pesados/médios e gestão do tempo de viagem."
                },
                {
                  "id": "d302595b-e918-5f42-bf2f-4ecec0576bbb",
                  "codigo": "m3c",
                  "titulo": "Procedimentos no Cliente",
                  "descricao": "Validação dos romaneios/etiquetas e coordenação da descarga junto à equipe de ajudantes, garantindo o manuseio seguro no local de entrega."
                },
                {
                  "id": "b5f85899-9a85-582f-8e4d-e3bdf40ba7ea",
                  "codigo": "m3d",
                  "titulo": "Conferência de Documentação e Canhotos",
                  "descricao": "Coleta correta de assinaturas, nomes legíveis e documento (RG/CPF) nos canhotos de notas fiscais e comprovantes digitais de entrega."
                }
              ]
            },
            {
              "numero": 4,
              "titulo": "Semana 4 — Gestão de Ocorrências em Rota, Devoluções e Postura Profissional",
              "atividades": [
                {
                  "id": "deef7cbb-47f6-52c9-988b-dbb0c0137abf",
                  "codigo": "m4a",
                  "titulo": "Postura Profissional e Dirigibilidade Defensiva",
                  "descricao": "Prática de condução defensiva, respeito às leis de trânsito e postura adequada no atendimento presencial ao cliente."
                },
                {
                  "id": "90570044-652c-52e4-9795-f6ea8bb7d114",
                  "codigo": "m4b",
                  "titulo": "Gestão de Ocorrências no Trânsito e Entregas",
                  "descricao": "Procedimento operacional para reporte imediato à coordenação em casos de avarias em trajeto, divergências no pedido, cliente ausente ou recusa de mercadorias."
                },
                {
                  "id": "cbf252b4-227a-5095-ae07-a397c35f5845",
                  "codigo": "m4c",
                  "titulo": "Comunicação com a Central/Logística",
                  "descricao": "Reporte contínuo do status do roteiro, ocorrências em rota e previsão de retorno à base."
                },
                {
                  "id": "dd7c1d09-2333-541b-b0ca-40cff35face3",
                  "codigo": "m4d",
                  "titulo": "Acondicionamento e Retorno de Devoluções",
                  "descricao": "Procedimento para amarração e proteção de produtos recusados ou avariados para transporte seguro de volta à fábrica."
                }
              ]
            },
            {
              "numero": 5,
              "titulo": "Semana 5 — Autonomia Progressiva na Condução e Cumprimento de Roteiros",
              "atividades": [
                {
                  "id": "a455b2dc-800c-59cf-8203-491464fce2f6",
                  "codigo": "m5a",
                  "titulo": "Gestão de Tempo e Eficiência na Rota",
                  "descricao": "Cumprimento da programação de entregas previstas no roteiro mantendo a segurança e integridade do veículo e da carga."
                },
                {
                  "id": "c8731c4b-dcd3-50a8-a5d7-f0052a69aa55",
                  "codigo": "m5b",
                  "titulo": "Encerramento de Rota e Checklist de Retorno",
                  "descricao": "Organização do veículo no final do expediente, limpeza da área de carga, organização de cintas/cantoneiras e registro de divergências no checklist final."
                }
              ]
            },
            {
              "numero": 6,
              "titulo": "Semana 6 — Consolidação de Processos e Avaliação do Período (45 dias)",
              "atividades": [
                {
                  "id": "c062542a-6f8c-523f-9488-ffaf7c978b59",
                  "codigo": "m6a",
                  "titulo": "Revisão Geral do Desempenho Operacional",
                  "descricao": "Execução autônoma da rotina completa de checklist veicular, carregamento, amarração, condução por roteiro e entregas."
                },
                {
                  "id": "9087780f-ebd1-5b42-8001-046239ec9d55",
                  "codigo": "m6b",
                  "titulo": "Avaliação Formal de Desempenho",
                  "descricao": "Reunião conjunta com a coordenação de logística, gerência e Recursos Humanos (RH) para análise dos 45 dias de experiência."
                },
                {
                  "id": "d5733de6-883b-5d16-9325-0766e05adce9",
                  "codigo": "m6c",
                  "titulo": "Decisão de Renovação/Efetivação",
                  "descricao": "Feedback estruturado com definição sobre a continuidade do contrato de trabalho."
                }
              ]
            }
          ],
          "criterios": [
            {
              "criterio": "Segurança, EPIs e Condução Defensiva",
              "padrao": "Uso 100% correto de EPIs e cumprimento rigoroso das normas de trânsito e segurança.",
              "frequencia": "Diária"
            },
            {
              "criterio": "Checklist e Conservação do Veículo",
              "padrao": "Execução diária do checklist pré-saída e manutenção do veículo em perfeitas condições de uso.",
              "frequencia": "Diária"
            },
            {
              "criterio": "Cuidado no Carregamento e Amarração",
              "padrao": "Zero avarias ou acidentes causados por má distribuição de peso ou amarração inadequada.",
              "frequencia": "Semanal"
            },
            {
              "criterio": "Acurácia de Rotas e Documentação",
              "padrao": "Cumprimento dos roteiros planejados e 100% dos canhotos/romaneios devidamente conferidos e assinados.",
              "frequencia": "Diária"
            },
            {
              "criterio": "Assiduidade e Pontualidade",
              "padrao": "Cumprimento rigoroso dos horários de apresentação, carregamento e saídas de rota.",
              "frequencia": "Semanal"
            }
          ]
        }
      ]
    }
  },
