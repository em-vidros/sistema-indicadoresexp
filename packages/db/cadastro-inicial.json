    "INTEGRACOES": {
      "motorista": {
        "funcao": "Motorista de Entrega / Transporte Logístico",
        "semanas": [
          {
            "titulo": "Semana 1 — Integração, Segurança (EPIs), Checklist Veicular, Leitura de Etiquetas e Tipos de Vidro",
            "atividades": [
              {
                "id": "m1a",
                "titulo": "Boas-vindas e Regulamento Interno",
                "desc": "Apresentação da equipe de logística e RH, normas da empresa, jornada de trabalho, políticas de frota e conduta profissional."
              },
              {
                "id": "m1b",
                "titulo": "Segurança e EPIs",
                "desc": "Treinamento obrigatório sobre o uso de Luvas de Proteção, Botina de Aço/Compósito, Óculos de Proteção e Protetor Auricular, bem como posturas ergométricas para o transporte e condução."
              },
              {
                "id": "m1c",
                "titulo": "Conhecimento dos Materiais (Tipos de Vidro)",
                "desc": "Apresentação detalhada dos tipos de produto transportados, entendendo a fragilidade, comportamento da carga durante o transporte e diferenças entre vidro comum, temperado e laminado."
              },
              {
                "id": "m1d",
                "titulo": "Sistema de Leitura e Conferência de Etiquetas",
                "desc": "Treinamento no sistema de conferência e leitura de etiquetas para identificação de dimensões, quantidades e destino dos materiais na expedição."
              },
              {
                "id": "m1e",
                "titulo": "Checklist Veicular Obrigatório",
                "desc": "Instrução sobre a rotina diária de verificação dos itens de segurança e funcionamento do veículo (pneus, freios, luzes, fluidos, equipamentos obrigatórios e conservação dos cavaletes)."
              },
              {
                "id": "m1f",
                "titulo": "Prática Orientada com Motorista Experiente",
                "desc": "Acompanhamento e atuação prática junto a um motorista sênior na rotina de pátio, forragem de peças, inspeção de veículos e movimentação interna na fábrica/depósito, sem atuação direta em rotas longas."
              }
            ]
          },
          {
            "titulo": "Semana 2 — Carregamento, Amarração, Distribuição de Carga e Transferências entre Filiais",
            "atividades": [
              {
                "id": "m2a",
                "titulo": "Foco em Carregamento e Distribuição de Peso",
                "desc": "Instrução e prática na correta disposição das peças de vidro nos cavaletes e carrinhos móveis do veículo, respeitando os limites de peso e estabilidade."
              },
              {
                "id": "m2b",
                "titulo": "Técnicas de Amarração e Proteção de Carga",
                "desc": "Aplicação prática de cantoneiras, proteções de borracha, cintas e catracas para travamento seguro dos vidros, eliminando folgas e riscos de avarias durante a movimentação."
              },
              {
                "id": "m2c",
                "titulo": "Separação, Leitura e Romaneios de Entrega",
                "desc": "Treinamento no manuseio de romaneios de carga, leitura das notas fiscais e conferência do manifesto de transporte."
              },
              {
                "id": "m2d",
                "titulo": "Rotas de Transferência entre Filiais",
                "desc": "Execução supervisionada de viagens de transferência de carga e insumos entre as filiais Angelim e Guajajaras, aplicando a lógica LIFO de arrumação por ordem de descarregamento."
              }
            ]
          },
          {
            "titulo": "Semana 3 — Roteiros de Rotas Urbanas, Condução e Documentação",
            "atividades": [
              {
                "id": "m3a",
                "titulo": "Primeiras Saídas em Rotas Urbanas",
                "desc": "Acompanhamento e condução do veículo dentro da cidade sob supervisão direta de um motorista experiente e suporte da coordenação."
              },
              {
                "id": "m3b",
                "titulo": "Planejamento e Otimização de Roteiros",
                "desc": "Leitura e interpretação dos roteiros de rota diários, análise de itinerários, rotas permitidas para veículos pesados/médios e gestão do tempo de viagem."
              },
              {
                "id": "m3c",
                "titulo": "Procedimentos no Cliente",
                "desc": "Validação dos romaneios/etiquetas e coordenação da descarga junto à equipe de ajudantes, garantindo o manuseio seguro no local de entrega."
              },
              {
                "id": "m3d",
                "titulo": "Conferência de Documentação e Canhotos",
                "desc": "Coleta correta de assinaturas, nomes legíveis e documento (RG/CPF) nos canhotos de notas fiscais e comprovantes digitais de entrega."
              }
            ]
          },
          {
            "titulo": "Semana 4 — Gestão de Ocorrências em Rota, Devoluções e Postura Profissional",
            "atividades": [
              {
                "id": "m4a",
                "titulo": "Postura Profissional e Dirigibilidade Defensiva",
                "desc": "Prática de condução defensiva, respeito às leis de trânsito e postura adequada no atendimento presencial ao cliente."
              },
              {
                "id": "m4b",
                "titulo": "Gestão de Ocorrências no Trânsito e Entregas",
                "desc": "Procedimento operacional para reporte imediato à coordenação em casos de avarias em trajeto, divergências no pedido, cliente ausente ou recusa de mercadorias."
              },
              {
                "id": "m4c",
                "titulo": "Comunicação com a Central/Logística",
                "desc": "Reporte contínuo do status do roteiro, ocorrências em rota e previsão de retorno à base."
              },
              {
                "id": "m4d",
                "titulo": "Acondicionamento e Retorno de Devoluções",
                "desc": "Procedimento para amarração e proteção de produtos recusados ou avariados para transporte seguro de volta à fábrica."
              }
            ]
          },
          {
            "titulo": "Semana 5 — Autonomia Progressiva na Condução e Cumprimento de Roteiros",
            "atividades": [
              {
                "id": "m5a",
                "titulo": "Gestão de Tempo e Eficiência na Rota",
                "desc": "Cumprimento da programação de entregas previstas no roteiro mantendo a segurança e integridade do veículo e da carga."
              },
              {
                "id": "m5b",
                "titulo": "Encerramento de Rota e Checklist de Retorno",
                "desc": "Organização do veículo no final do expediente, limpeza da área de carga, organização de cintas/cantoneiras e registro de divergências no checklist final."
              }
            ]
          },
          {
            "titulo": "Semana 6 — Consolidação de Processos e Avaliação do Período (45 dias)",
            "atividades": [
              {
                "id": "m6a",
                "titulo": "Revisão Geral do Desempenho Operacional",
                "desc": "Execução autônoma da rotina completa de checklist veicular, carregamento, amarração, condução por roteiro e entregas."
              },
              {
                "id": "m6b",
                "titulo": "Avaliação Formal de Desempenho",
                "desc": "Reunião conjunta com a coordenação de logística, gerência e Recursos Humanos (RH) para análise dos 45 dias de experiência."
              },
              {
                "id": "m6c",
                "titulo": "Decisão de Renovação/Efetivação",
                "desc": "Feedback estruturado com definição sobre a continuidade do contrato de trabalho."
              }
            ]
          }
        ],
        "matriz": [
          {
            "criterio": "Segurança, EPIs e Condução Defensiva",
            "padrao": "Uso 100% correto de EPIs e cumprimento rigoroso das normas de trânsito e segurança.",
            "freq": "Diária"
          },
          {
            "criterio": "Checklist e Conservação do Veículo",
            "padrao": "Execução diária do checklist pré-saída e manutenção do veículo em perfeitas condições de uso.",
            "freq": "Diária"
          },
          {
            "criterio": "Cuidado no Carregamento e Amarração",
            "padrao": "Zero avarias ou acidentes causados por má distribuição de peso ou amarração inadequada.",
            "freq": "Semanal"
          },
          {
            "criterio": "Acurácia de Rotas e Documentação",
            "padrao": "Cumprimento dos roteiros planejados e 100% dos canhotos/romaneios devidamente conferidos e assinados.",
            "freq": "Diária"
          },
          {
            "criterio": "Assiduidade e Pontualidade",
            "padrao": "Cumprimento rigoroso dos horários de apresentação, carregamento e saídas de rota.",
            "freq": "Semanal"
          }
        ]
      },
